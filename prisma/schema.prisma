generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Food {
  id        Int      @id @default(autoincrement())
  name      String
  category  String?
  status    String   @default("WANT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}