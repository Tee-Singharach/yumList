generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Food {
  id        Int      @id @default(autoincrement())
  name      String
  status    String   @default("NOT_EATEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}